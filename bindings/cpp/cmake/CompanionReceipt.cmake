# Fingerprint declared installed SDK inputs independently of their install paths.
function(rexgraph_companion_receipt digest_output members_output temporal_include_output)
  set(entries "")
  set(members "")
  set(temporal_include "")
  foreach(component IN ITEMS "rfc::numeric|rfc" "rexlogic::model|rexlogic" "rex_temporal::runtime|rex_temporal")
    string(REPLACE "|" ";" fields "${component}")
    list(GET fields 0 dependency)
    list(GET fields 1 name_space)
    if(NOT TARGET ${dependency})
      message(FATAL_ERROR "The installed SDK lacks ${dependency}")
    endif()
    get_target_property(directories ${dependency} INTERFACE_INCLUDE_DIRECTORIES)
    set(found_headers FALSE)
    foreach(directory IN LISTS directories)
      if(NOT IS_DIRECTORY "${directory}/${name_space}")
        continue()
      endif()
      file(GLOB_RECURSE headers CONFIGURE_DEPENDS
        "${directory}/${name_space}/*.hpp" "${directory}/${name_space}/*.h")
      foreach(header IN LISTS headers)
        file(RELATIVE_PATH relative "${directory}" "${header}")
        file(SHA256 "${header}" digest)
        list(APPEND entries "header:${relative}:${digest}")
        list(APPEND members "${header}")
        set(found_headers TRUE)
      endforeach()
      if(name_space STREQUAL "rex_temporal" AND EXISTS "${directory}/rex_temporal/action_programs.hpp")
        set(temporal_include "${directory}")
      endif()
    endforeach()
    if(NOT found_headers)
      message(FATAL_ERROR "The installed SDK declares no headers for ${dependency}")
    endif()
  endforeach()
  get_target_property(configurations rex_temporal::runtime IMPORTED_CONFIGURATIONS)
  set(configurations DEFAULT ${configurations})
  list(REMOVE_DUPLICATES configurations)
  set(found_archive FALSE)
  foreach(configuration IN LISTS configurations)
    if(configuration STREQUAL "DEFAULT")
      get_target_property(location rex_temporal::runtime IMPORTED_LOCATION)
    else()
      get_target_property(location rex_temporal::runtime IMPORTED_LOCATION_${configuration})
    endif()
    if(location)
      file(SHA256 "${location}" digest)
      get_filename_component(filename "${location}" NAME)
      list(APPEND entries "archive:rex_temporal::runtime:${configuration}:${filename}:${digest}")
      list(APPEND members "${location}")
      set(found_archive TRUE)
    endif()
  endforeach()
  if(NOT found_archive OR NOT temporal_include)
    message(FATAL_ERROR "The installed temporal SDK lacks its runtime archive or public program headers")
  endif()
  list(REMOVE_DUPLICATES entries)
  list(SORT entries)
  list(JOIN entries "\n" receipt)
  string(SHA256 digest "${receipt}\n")
  list(REMOVE_DUPLICATES members)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${members})
  set(${digest_output} "${digest}" PARENT_SCOPE)
  set(${members_output} "${members}" PARENT_SCOPE)
  set(${temporal_include_output} "${temporal_include}" PARENT_SCOPE)
endfunction()

# Companion-enabled wheels retain the terms of their linked SDK components.
function(rexgraph_install_companion_terms package_directory)
  foreach(component IN ITEMS RexLogic RexTemporal)
    foreach(kind IN ITEMS LICENSE NOTICE)
      set(variable "${component}_${kind}_FILE")
      if(NOT EXISTS "${${variable}}")
        message(FATAL_ERROR "The selected ${component} SDK lacks its ${kind} file")
      endif()
      install(FILES "${${variable}}" DESTINATION "${package_directory}/companion_terms/${component}")
    endforeach()
  endforeach()
endfunction()
